{
  "plugin": "org.smartide.plugin.editor",
  "run": "echo 'change command from .si.json file'",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".cpp": {
      "enabled": false,
      "run": "clangd"
    },
    ".cs": {
      "enabled": false,
      "run": "omnisharp -lsp"
    },
    ".xml": {
      "enabled": false,
      "run": "lemminx"
    },
    ".hpp": {
      "enabled": false,
      "run": "clangd"
    },
    ".yaml": {
      "enabled": false,
      "run": "yaml-language-server --stdio"
    },
    ".toml": {
      "enabled": false,
      "run": "taplo lsp stdio"
    },
    ".md": {
      "enabled": false,
      "run": "marksman server"
    },
    ".py": {
      "enabled": false,
      "run": "pylsp"
    },
    ".rs": {
      "enabled": false,
      "run": "rust-analyzer"
    },
    ".sh": {
      "enabled": false,
      "run": "bash-language-server start"
    },
    ".bash": {
      "enabled": false,
      "run": "bash-language-server start"
    }
  }
}